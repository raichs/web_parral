# Caché: el HTML se revisa siempre; CSS, JS e imágenes se guardan un año
# porque el deploy les añade ?v=<huella> y cambian de URL cuando cambian.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Temporal: que los buscadores no indexen el sitio mientras está en desarrollo
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Compresión: HTML, CSS, JS y SVG viajan comprimidos (~70 % menos)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>
